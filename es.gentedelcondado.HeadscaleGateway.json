{
  "app-id": "es.gentedelcondado.HeadscaleGateway",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "headscale-gateway-launcher",
  "finish-args": [
    "--share=network"
  ],
  "modules": [
    {
      "name": "headscale-gateway",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 headscale-gateway /app/bin/headscale-gateway",
        "install -Dm755 files/headscale-gateway-launcher /app/bin/headscale-gateway-launcher",
        "install -Dm644 files/es.gentedelcondado.HeadscaleGateway.desktop /app/share/applications/es.gentedelcondado.HeadscaleGateway.desktop",
        "install -Dm644 files/es.gentedelcondado.HeadscaleGateway.metainfo.xml /app/share/metainfo/es.gentedelcondado.HeadscaleGateway.metainfo.xml",
        "install -Dm644 files/es.gentedelcondado.HeadscaleGateway.png /app/share/icons/hicolor/128x128/apps/es.gentedelcondado.HeadscaleGateway.png",
        "install -Dm644 files/LICENSE /app/share/licenses/headscale-gateway/LICENSE",
        "install -Dm644 files/NOTICE /app/share/licenses/headscale-gateway/NOTICE",
        "cp -a files/notices /app/share/licenses/headscale-gateway/notices"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://github.com/Gente-del-Condado/headscale_gateway_ynh/releases/download/server-v1.4.12/headscale-gateway-linux-amd64",
          "sha256": "5c061f2912cae402566cee4097f38daad000e98e51058802ead89cd87fee6c70",
          "dest-filename": "headscale-gateway",
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "file",
          "url": "https://github.com/Gente-del-Condado/headscale_gateway_ynh/releases/download/server-v1.4.12/headscale-gateway-linux-arm64",
          "sha256": "db575d15359c7254279dc345eff71fcfcc4235ec61800e847c5b760d287ab39c",
          "dest-filename": "headscale-gateway",
          "only-arches": [
            "aarch64"
          ]
        },
        {
          "type": "dir",
          "path": "files",
          "dest": "files"
        }
      ]
    }
  ]
}
